{
  "version": "3.0.0",
  "maxPlayers": 400,
  "gameServers": [
    {
      "is-secure": true,
      "public-host": "<Your WebSocket Domain>",
      "key": "<Key>",
      "host": "127.0.0.2",
      "port": 8080,
      "cid": 1,
      "reconnect": {
        "enabled": true,
        "retryInterval": 86400
      }
    }
  ],
  "serviceMode": "NORMAL",
  "mainPage": {
    "status": false,
    "title": "",
    "body": "",
    "noticeTitle": "",
    "noticeMessage": "",
    "showNotice": false
  },
  "admins": [
    {
      "id": "<Account UUID>",
      "name": "<User Name>",
      "team": "<Team Name>",
      "privileges": [
        "CONNECTION_LOG",
        "WORD",
        "CROSSWORD",
        "MAILBOX",
        "SHOP",
        "USER_MODERATION_READ",
        "USER_SANCTION_ISSUE",
        "USER_SANCTION_REVOKE",
        "REPORT_RESOLVE",
        "SANCTION_POLICY_OVERRIDE",
        "SANCTION_COUNTER_RESET"
      ]
    }
  ],
  "cdnHost": "<CDN Host>",
  "apiKey": "<API Key>",
  "cryptoKey": "<32-Bit Secret Key>",
  "geoIp": {
    "db11Path": "/path/to/IP2LOCATION-LITE-DB11.IPV6.BIN",
    "asnPath": "/path/to/IP2LOCATION-LITE-ASN.IPV6.BIN",
    "domesticExemptCidrs": [
      "1.2.3.4/32"
    ]
  },
  "connectionLog": {
    "retention": {
      "enabled": true,
      "months": 12,
      "batchSize": 10000,
      "maxBatchesPerRun": 10
    }
  },
  "suspicionLog": {
    "retention": {
      "enabled": true,
      "months": 12,
      "batchSize": 10000,
      "maxBatchesPerRun": 10
    }
  },
  "reportLog": {
    "retention": {
      "enabled": true,
      "months": 36,
      "batchSize": 10000,
      "maxBatchesPerRun": 10
    }
  },
  "moderationLogService": {
    "publicUrl": "https://logs-admin.kkutu.io",
    "signingSecret": "<32-Bit or Longer Secret Key>"
  }
}
